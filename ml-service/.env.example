# ============================================================
# ClimaGPT — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit your .env file to version control.
# ============================================================

# Django core
SECRET_KEY=your-very-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL database URL
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://climagpt_user:climagpt_pass@localhost:5432/climagpt_db

# Mapbox (used for reverse geocoding farm coordinates)
# Get your token at: https://account.mapbox.com/
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here

# CORS (comma-separated list of allowed frontend origins in production)
# CORS_ALLOWED_ORIGINS=https://yourfrontend.com

# ── Stage 2: Weather Configuration ──────────────────────────────────────────
# Weather provider: OPEN_METEO (default, free, no API key required)
# Future values: IMD, ECMWF, GFS, NASA
WEATHER_PROVIDER=OPEN_METEO

# How many minutes to cache weather data before re-fetching from provider
WEATHER_CACHE_MINUTES=30
