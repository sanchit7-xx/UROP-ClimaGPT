# Environment variables — NEVER commit
.env
*.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
wheels/

# Virtual environments
venv/
.venv/
env/
ENV/
.env/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
static_root/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Testing
.coverage
htmlcov/
.tox/
.pytest_cache/
coverage.xml
*.cover

# Migrations (keep migrations in version control)
# Do NOT ignore migrations — they must be committed.
